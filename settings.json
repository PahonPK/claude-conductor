{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{AGENT_HOME}}/hooks/memory-checkpoint.js\" PreCompact --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{AGENT_HOME}}/hooks/memory-checkpoint.js\" SessionEnd --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{AGENT_HOME}}/hooks/memory-checkpoint.js\" SessionStart --agent claude",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{AGENT_HOME}}/hooks/memory-guard.js\" SessionStart --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{AGENT_HOME}}/hooks/memory-guard.js\" PostToolUse --agent claude",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skipWorkflowUsageWarning": true
}
